# backend-api/public/.htaccess
# EL KAROOZ School - Enterprise Production Hardening

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Pass Authorization header to PHP across FastCGI / LiteSpeed / OpenResty
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block HTTP methods that are not allowed
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT|DEBUG) [NC]
    RewriteRule ^.*$ - [F]

    # Block direct HTTP access to internal source directories.
        # The trailing (?:/|$) matters: without it a path like /config/app.php
        # would not be matched by ^(src|config|vendor)/.
        RewriteRule ^(?:src|config|vendor)(?:/|$) - [F,L]

        # Defense in depth: no PHP file may be reached by any path except the front
        # controller. The rules above only exist inside <IfModule mod_rewrite.c>,
        # so on a host with mod_rewrite disabled Apache would happily execute
        # /src/Utils/*.php directly.
        RewriteCond %{REQUEST_URI} !^/index\.php$
        RewriteRule \.php$ - [F,L]

    # Block sensitive files and extensions
    RewriteRule ^(\.env|\.git|\.htaccess|\.sql|\.bak|\.log|\.ini|\.sh)$ - [F,L]
    RewriteRule ^(composer\.(json|lock)|package\.json|package-lock\.json)$ - [F,L]

    # Send all legitimate requests to front controller
    RewriteCond %{REQUEST_URI} ^/storage/ [OR]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# Disable directory browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Prevent MIME Sniffing & enforce UTF-8
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
</IfModule>
