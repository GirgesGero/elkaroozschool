# Environment Variables for EL KAROOZ School PHP Backend (`backend-api`)
# Place the production `.env` file ONE directory ABOVE `public_html/`.
# Names below match `backend-api/config/supabase.php`, `config/app.php`, and `config/storage.php`.

# ============================================================================
# 1. Supabase & JWT Configuration (Required by `config/supabase.php`)
# ============================================================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="[REDACTED]"
SUPABASE_SERVICE_ROLE_KEY="[REDACTED]"
# Must be the secret key from Supabase Dashboard -> Settings -> API -> JWT Secret (NEVER a public JWKS URL):
SUPABASE_JWT_SECRET="[REDACTED-MIN-32-CHARS]"

# ============================================================================
# 2. Application & Storage Settings (`config/app.php` & `config/storage.php`)
# ============================================================================
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://elkaroozschool.is-best.net"
STORAGE_PUBLIC_URL="https://elkaroozschool.is-best.net/storage"

# Comma-separated trusted reverse proxy IPs for `ClientIp.php` (leave empty if direct):
TRUSTED_PROXIES=""

# ============================================================================
# 3. Google Drive & Apps Script Bridge (Optional — `StorageBridgeService` & `BibleDataService`)
# ============================================================================
GOOGLE_DRIVE_ROOT_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPS_SCRIPT_URL=""
GOOGLE_APPS_SCRIPT_TOKEN=""
REQUIRE_GOOGLE_DRIVE=false
