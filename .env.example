# ─────────────────────────────────────────────────────────────
# EL KAROOZ SCHOOL — environment contract
# Copy to .env.local (frontend) and set the matching values in the
# Hostinger panel (PHP). NEVER commit a filled-in copy.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Vercel → Settings → Environment Variables) ──
# Visibility MUST be "Config" for NEXT_PUBLIC_* — Vercel rejects
# `secret` visibility on a public framework prefix and silently ships
# an un-inlined build, which breaks login at runtime.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# ── PHP backend (Hostinger → Advanced → Environment Variables) ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
# server-side ONLY — never NEXT_PUBLIC_*, never in the client bundle
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX
# Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-project-jwt-secret

APP_URL=https://elkaroozschool.is-best.net
APP_ENV=production
APP_DEBUG=false
STORAGE_PUBLIC_URL=https://elkaroozschool.is-best.net/storage

# ── Optional ──
# Only set once the PHP API is actually live. No localhost, no fake domain.
# The frontend does not currently read this variable.
# NEXT_PUBLIC_PHP_API_URL=https://elkaroozschool.is-best.net

# ── Test-account passwords (scripts/ only) ──
# These were hardcoded in 11 verification scripts and on the public /login
# page. They are REAL accounts on the production Supabase project, so the
# literals are gone from the repository and the quick-login buttons on
# /login have been removed. The scripts now fail loudly if these are unset
# rather than falling back to a committed password.
# Rotate all of these before go-live: they are in git history.
EK_PW_ADMIN=
EK_PW_SUPER_USER=
EK_PW_SERVANT=
EK_PW_TRAINEE=
EK_PW_SECRETARIAT=
EK_PW_SUSPENDED=
