# ─────────────────────────────────────────────────────────────
# EL KAROOZ SCHOOL — Environment Variables Contract (v1.0.1)
# IMPORTANT:
# 1. For Frontend (`frontend/.env.local` & Vercel): copy ONLY the
#    Frontend section (`NEXT_PUBLIC_*` + `SYSTEM_RESET_CONFIRMATION_SECRET`).
#    NEVER copy `SUPABASE_SERVICE_ROLE_KEY` or `SUPABASE_JWT_SECRET` into `frontend/.env.local`.
# 2. For PHP Backend (Hostinger `.env` outside `public_html/`): copy ONLY
#    the PHP Backend section. NEVER commit a filled-in `.env` file.
# ─────────────────────────────────────────────────────────────

# ── 1. Frontend (Vercel → Settings → Environment Variables & `frontend/.env.local`) ──
# Visibility MUST be "Config" for NEXT_PUBLIC_* on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
# Required by `frontend/src/lib/api/php.ts` for backups, restore, imports, exports, storage, system-reset & Bible API:
NEXT_PUBLIC_PHP_API_URL=https://elkaroozschool.is-best.net
# Optional server-side secret for Next.js `/api/system-reset/*` HMAC token signing (falls back to SUPABASE_SERVICE_ROLE_KEY if unset):
SYSTEM_RESET_CONFIRMATION_SECRET=change-this-to-a-32-byte-random-secret

# ── 2. PHP Backend (`backend-api` — Hostinger `.env` ABOVE `public_html/`) ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
# Server-side ONLY — never prefix with NEXT_PUBLIC_*, never place in `frontend/.env.local`:
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX
# Supabase Dashboard → Settings → API → JWT Secret (must be the secret key, NEVER a public JWKS URL):
SUPABASE_JWT_SECRET=your-project-hs256-jwt-secret-min-32-chars

APP_URL=https://elkaroozschool.is-best.net
APP_ENV=production
APP_DEBUG=false
STORAGE_PUBLIC_URL=https://elkaroozschool.is-best.net/storage

# Optional Google Drive & Apps Script integration (`StorageBridgeService` / `BibleDataService`):
GOOGLE_DRIVE_ROOT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
REQUIRE_GOOGLE_DRIVE=false

# ── 3. Test-account passwords (`scripts/` E2E verification only — never run against production) ──
EK_PW_ADMIN=
EK_PW_SUPER_USER=
EK_PW_SERVANT=
EK_PW_TRAINEE=
EK_PW_SECRETARIAT=
EK_PW_SUSPENDED=
